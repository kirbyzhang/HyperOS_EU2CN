# Public source allowlist. Local ROMs, logs, keys, device identities and releases
# remain on this workstation and must never enter the repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/docs/
!/config/
!/scripts/
!/tests/
!/.github/
!/toolsbox-hyperos3-pudding/
!/build/

/build/*
!/build/pudding-eu-localization/
/build/pudding-eu-localization/*
!/build/pudding-eu-localization/*.sh
!/build/pudding-eu-localization/*.tsv
!/build/pudding-eu-localization/*.ini
!/build/pudding-eu-localization/*.prop
!/build/pudding-eu-localization/README.md
!/build/pudding-eu-localization/META-INF/
!/build/pudding-eu-localization/overlay-src/

**/.gradle/
/toolsbox-hyperos3-pudding/**/build/
**/local.properties
**/__pycache__/
*.pyc
*.apk
*.apks
*.idsig
*.dex
*.so
*.zip
*.7z
*.img
*.pk8
*.pem
*.jks
*.keystore
*.key
*.log
.DS_Store
Thumbs.db
